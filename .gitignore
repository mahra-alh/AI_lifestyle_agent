# DEPENDENCIES
# Node dependencies installed locally (huge, machine-specific)
node_modules/

# BUILD OUTPUT
# Compiled frontend files (generated automatically)
build/

# TESTING OUTPUT
# Code coverage reports
coverage/

# OS / SYSTEM FILES
# MacOS hidden system file
.DS_Store

# ENVIRONMENT VARIABLES
# Main env files (contain secrets or local config)
.env
# Any environment-specific files (development, production, local, etc.)
.env.*

# PYTHON ENVIRONMENTS / CACHE
# Local virtual environments and Python bytecode cache files
.venv/
venv/
__pycache__/
*.pyc

# APP LOGS
# Local structured/app logs generated during development
logs/

# LOCAL SECRETS FOLDER
# Any local folder used to store secrets or private config files
secrets/

# WINDOWS SYSTEM FILE
# Windows hidden thumbnail cache file
Thumbs.db

# LOG FILES
# Debug logs generated by npm/yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# FIREBASE (LOCAL CACHE)
# Firebase CLI cache (not needed in repo)
.firebase/

# SECRET FILES
# Service account keys (Firebase, GCP, etc.)
serviceAccountKey.json

# Any JSON files containing secrets or keys
*secret*.json
*key*.json
*.log
*.jsonl

# MACHINE LEARNING FILES
# Trained model files (can be large, avoid committing unless needed)
*.pkl      # scikit-learn / pickle models
*.h5       # Keras / TensorFlow models
*.pt       # PyTorch models
*.onnx     # ONNX models
backend/config/serviceAccountKey.json
firebase-adminsdk*.json
backend/data/
*.bin
*.npy
*.csv

# Explicit exclusion of user profiles (sensitive data)
data/user_profiles.json
data/user_profiles
data/weather/
data/calendar

# GOOGLE CREDENTIALS (sensitive, should not be committed)
credentials.json
token.json

# LEGACY DUPLICATE SOURCE TREE
# Old copy of the package kept locally during migration to ai_agent/
AI Agent/
